# Native development (uvicorn + next dev on your machine). Copy to backend/.env.
# Values here override the repository-level .env; real environment variables override both.
BDNA_ENVIRONMENT=development
BDNA_SECRET_KEY=dev-only-secret-key-change-me-0123456789
BDNA_DATABASE_OWNER_URL=postgresql+psycopg://bdna_owner:bdna_owner@localhost:5432/bdna
BDNA_DATABASE_APP_URL=postgresql+psycopg://bdna_app:bdna_app@localhost:5432/bdna
BDNA_DATABASE_SYSTEM_URL=postgresql+psycopg://bdna_system:bdna_system@localhost:5432/bdna
BDNA_STORAGE_BACKEND=local
BDNA_STORAGE_LOCAL_ROOT=./var/storage
# The dashboard runs on :3000 and forwards /v1/* to the API, so file URLs use that origin.
BDNA_PUBLIC_BASE_URL=http://localhost:3000
BDNA_MCP_PUBLIC_URL=http://localhost:8001
BDNA_CORS_ORIGINS=["http://localhost:3000"]
BDNA_AI_VISION_PROVIDER=dev
BDNA_AI_TEXT_PROVIDER=dev
BDNA_AI_EMBEDDING_PROVIDER=dev
