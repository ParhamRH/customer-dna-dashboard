# =============================================================================================
# Brand DNA & Creative Intelligence Platform — deployment configuration (Docker Compose)
#
#   cp .env.example .env     and replace every CHANGE-ME. Never commit .env.
#
# Generate secrets with:   openssl rand -base64 48 | tr -d '\n=/+' | cut -c1-48
# Fernet key:              python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Native (non-Docker) development uses backend/.env instead — see backend/.env.example.
# =============================================================================================

# --- Runtime ---------------------------------------------------------------------------------
BDNA_ENVIRONMENT=production
# Signs sessions, signed file URLs and webhook test payloads. 32+ random characters.
BDNA_SECRET_KEY=CHANGE-ME
# Encrypts integration secrets (webhook signing secrets, customer AI keys) at rest. Fernet key.
BDNA_ENCRYPTION_KEY=CHANGE-ME
# Session cookie: true whenever the site is served over HTTPS (it should be in production).
BDNA_COOKIE_SECURE=false
BDNA_SESSION_TTL_HOURS=168

# --- Public addresses ------------------------------------------------------------------------
# Caddy listens on BDNA_SITE_ADDRESS. ":80" = plain HTTP on BDNA_HTTP_PORT; a domain such as
# "brand.example.com" enables automatic HTTPS (then publish ports 80/443 and set the URLs below).
BDNA_SITE_ADDRESS=:80
BDNA_HTTP_PORT=8080
BDNA_HTTPS_PORT=8443
# Where browsers reach the platform (signed local-storage file URLs, links in webhooks).
BDNA_PUBLIC_BASE_URL=http://localhost:8080
# Where external AI clients reach the MCP server (Caddy routes /mcp to it).
BDNA_MCP_PUBLIC_URL=http://localhost:8080
BDNA_CORS_ORIGINS=["http://localhost:8080"]

# --- PostgreSQL (pgvector) -------------------------------------------------------------------
# Superuser, used only by the container's first-start init script.
POSTGRES_PASSWORD=CHANGE-ME
BDNA_DB_NAME=bdna
# Three roles (docs/adr/0002-tenant-isolation.md):
#   owner  — runs migrations; app — every request, Row Level Security enforced;
#   system — BYPASSRLS, used only by a few narrow platform-wide functions.
BDNA_DB_OWNER_PASSWORD=CHANGE-ME
BDNA_DB_APP_PASSWORD=CHANGE-ME
BDNA_DB_SYSTEM_PASSWORD=CHANGE-ME
BDNA_DB_POOL_SIZE=10
# Using a managed database (e.g. Supabase) instead of the bundled container? Set the three URLs
# explicitly in docker-compose.override.yml — see docs/operations.md.

# --- Object storage --------------------------------------------------------------------------
# local = files on the Docker `storage` volume (default; works out of the box).
# s3    = Amazon S3, Cloudflare R2 or any S3-compatible store — recommended for production:
#   BDNA_STORAGE_BACKEND=s3
#   BDNA_S3_BUCKET=brand-dna
#   BDNA_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   BDNA_S3_PUBLIC_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   BDNA_S3_ADDRESSING_STYLE=auto
#   BDNA_S3_REGION=auto
#   BDNA_S3_ACCESS_KEY_ID=...
#   BDNA_S3_SECRET_ACCESS_KEY=...
BDNA_STORAGE_BACKEND=local
# Only for the optional bundled MinIO (docker compose --profile minio):
MINIO_ROOT_USER=bdna
MINIO_ROOT_PASSWORD=CHANGE-ME
BDNA_MINIO_PORT=9000
BDNA_SIGNED_URL_TTL_SECONDS=900
BDNA_MAX_UPLOAD_BYTES=2147483648

# --- AI providers (provider-independent) -----------------------------------------------------
# "dev" is a clearly labelled development adapter: deterministic heuristics computed from the
# media itself, no external calls. Its output is marked "dev adapter" everywhere in the UI.
BDNA_AI_VISION_PROVIDER=dev          # dev | anthropic | openai | openai_compatible
BDNA_AI_TEXT_PROVIDER=dev            # dev | anthropic | openai | openai_compatible
BDNA_AI_EMBEDDING_PROVIDER=dev       # dev | openai | openai_compatible
BDNA_AI_VISUAL_EMBEDDING_PROVIDER=dev  # dev | http (self-hosted CLIP/SigLIP service)
BDNA_ANTHROPIC_API_KEY=
BDNA_ANTHROPIC_MODEL=claude-sonnet-5-5
BDNA_OPENAI_API_KEY=
BDNA_OPENAI_BASE_URL=https://api.openai.com/v1
BDNA_OPENAI_VISION_MODEL=gpt-4.1-mini
BDNA_OPENAI_TEXT_MODEL=gpt-4.1-mini
BDNA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BDNA_OPENAI_EMBEDDING_DIMENSIONS=1536
BDNA_VISUAL_EMBEDDING_URL=
BDNA_VISUAL_EMBEDDING_DIMENSIONS=512
BDNA_AI_MAX_IMAGES_PER_ASSET=6
BDNA_AI_REQUEST_TIMEOUT_SECONDS=120
# Install Docling (PyTorch, large image) for richer document parsing: 1 = yes.
BDNA_WITH_DOCLING=0

# --- Workers & retention ---------------------------------------------------------------------
BDNA_WORKER_CONCURRENCY=2
BDNA_WORKER_POLL_SECONDS=1.0
BDNA_MAX_VIDEO_KEYFRAMES=24
BDNA_MAX_DOCUMENT_PAGES_RENDERED=30
BDNA_EXPORT_TTL_DAYS=14

# --- Outbound requests to customer-supplied URLs (webhooks, AI base URLs) -------------------
# In production, private/internal addresses are refused (SSRF protection). Hosts listed here
# are allowed anyway — e.g. the n8n container inside the Compose network.
BDNA_OUTBOUND_ALLOWED_HOSTS=["n8n"]
# BDNA_OUTBOUND_ALLOW_PRIVATE=false

# --- Optional: n8n (docker compose --profile automation up -d) --------------------------------
N8N_ENCRYPTION_KEY=CHANGE-ME
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Optional: demo data (docker compose --profile demo run --rm demo-seed) -------------------
# Loads three FICTIONAL customers. Development and evaluation only.
BDNA_DEMO_ADMIN_EMAIL=admin@platform.local
BDNA_DEMO_ADMIN_PASSWORD=CHANGE-ME
