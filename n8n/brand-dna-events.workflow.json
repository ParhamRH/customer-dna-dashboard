    {
      "id": "a8e9d4b0-c5d9-4272-bbe7-a44b2f1fcf29",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Verify the Brand DNA signature over the exact raw body, then reject stale timestamps.\n// Requires NODE_FUNCTION_ALLOW_BUILTIN=crypto (set in docker-compose.yml) and the webhook's\n// signing secret in the n8n environment as BDNA_WEBHOOK_SECRET.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst raw = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\nconst secret = $env.BDNA_WEBHOOK_SECRET;\nif (!secret) throw new Error('BDNA_WEBHOOK_SECRET is not set in the n8n environment');\nconst ts = headers['x-bdna-timestamp'];\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(ts + '.' + raw).digest('hex');\nconst given = headers['x-bdna-signature'] || '';\nif (given.length !== expected.length || !crypto.timingSafeEqual(Buffer.from(given), Buffer.from(expected))) {\n  throw new Error('Invalid Brand DNA signature');\n}\nif (Math.abs(Date.now() / 1000 - Number(ts)) > 300) throw new Error('Stale Brand DNA event (replay protection)');\nconst event = JSON.parse(raw);\nreturn [{ json: event }];"
      }
    },
    {
      "id": "778151cb-e6bf-4b23-b776-956116f648b9",
      "name": "Asset processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
