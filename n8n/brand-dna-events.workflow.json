    {
      "id": "d72b701a-fdd5-42d1-822a-30a9729b497c",
      "name": "Summarise for the team",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Turn the asset detail into a short, honest notification. AI interpretations that nobody has\n// reviewed yet are labelled as such \u2014 they are not official brand knowledge.\nconst a = $input.first().json;\nconst pending = (a.analyses || []).filter((x) => x.status === 'pending_review').length;\nreturn [{ json: {\n  text: `New asset processed: ${a.title} (${a.asset_type}). ` +\n        (pending ? `${pending} AI interpretation(s) waiting for review.` : 'No AI output pending review.'),\n  asset_id: a.id,\n  organization_id: $('Verify signature').first().json.organization_id,\n} }];"
      }
    },
    {
      "id": "8fcc81e9-50f7-4824-9d1b-ae5b926c7a04",
